# Copy to .env before the first `docker compose up`. .env is gitignored.
#
# Local development only. These credentials are here because the database is not
# reachable from outside the laptop; the Oracle box in Phase 7 takes them from a
# Kubernetes Secret and none of these values follow it there.

POSTGRES_USER=kinex
POSTGRES_PASSWORD=kinex
POSTGRES_DB=kinex

# Read by the API and migrate containers. `postgres` is the compose service name; from
# the host the same database is at localhost:5432.
KINEX_DATABASE_URL=postgresql://kinex:kinex@postgres:5432/kinex

KINEX_ENV=local
KINEX_LOG_LEVEL=INFO
KINEX_OLLAMA_URL=http://ollama:11434

# The model the ollama-pull one-shot fetches. Locked to a 3B-class model in the root design doc:
# nothing larger serves on 2 ARM cores.
OLLAMA_MODEL=qwen2.5:3b
