# Copy to .env before the first `docker compose up`. .env is gitignored.
#
# Local development only. These credentials are here because the database is not
# reachable from outside the laptop; the Oracle box in Phase 7 takes them from a
# Kubernetes Secret and none of these values follow it there.

POSTGRES_USER=kinex
POSTGRES_PASSWORD=kinex
POSTGRES_DB=kinex

# Read by the API and migrate containers. `postgres` is the compose service name; from
# the host the same database is at localhost:5432.
KINEX_DATABASE_URL=postgresql://kinex:kinex@postgres:5432/kinex

# Signs the JWTs the server issues. HS256 — the device never verifies a token, only the
# server does, so there is no reason for an asymmetric signing key here. No default on
# purpose: a shipped default signing secret means anyone can mint a token for any device.
# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
KINEX_JWT_SECRET=local-development-only-do-not-use-this-value-anywhere-real

KINEX_ENV=local
KINEX_LOG_LEVEL=INFO
KINEX_OLLAMA_URL=http://ollama:11434

# The models the ollama-pull one-shot fetches. The chat model is locked to a 3B-class one
# in the root design doc: nothing larger serves on 2 ARM cores. The embedding model is small and
# is on the interactive path — an embedding is one forward pass, not a decode loop, which
# is why it can live on the same CPU that is too slow to generate chat.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Groq, for interactive coach chat. Free tier, from https://console.groq.com/keys.
# No default in Settings on purpose: a chat request that discovers the key is missing has
# already spent a retrieval round trip and a user's question, so this fails at startup
# naming the variable instead. Unlike the Postgres password above, this one is a real
# credential for a real third-party account — it is why .env is gitignored, and Phase 7
# takes it from a Kubernetes Secret.
KINEX_GROQ_API_KEY=
