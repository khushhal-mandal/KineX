*.iml
.gradle
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# Dev-only tooling environment for tools/. Rebuilt from tools/requirements.txt; never
# shipped, and several hundred MB of native wheels that must not reach a commit.
/tools/.venv
/tools/__pycache__

# Source clips for fixture extraction. The extracted .jsonl fixture is what the tests
# read and what belongs in the repo — the video it came from does not.
/videos
/tools/videos

# The module's build output. /build above only covers the root project, and this is where
# the 34 MB APK and the CMake objects land.
/app/build

# Kotlin compiler's incremental session directory.
/.kotlin

# Signing material. Nothing matches today — the release keystore arrives in Phase 11 — but
# a key that reaches a public GitHub repo cannot be un-published, only revoked, and by then
# every APK it signed is orphaned. The pattern goes in before the file exists, not after.
*.jks
*.keystore
keystore.properties

# Backend local-development environment. Holds the local Postgres credentials, which are
# only safe because that database is not reachable from outside the laptop. The Oracle box
# takes its own from a Kubernetes Secret in Phase 7 and no value here follows it there.
# backend/.env.example is committed and is what a new machine copies.
/backend/.env

# Python bytecode and local virtualenvs anywhere in the tree. /tools/__pycache__ above
# predates the backend and is now covered by these; it is left alone rather than merged.
__pycache__/
*.py[cod]
/backend/.venv

# Which device was last selected to deploy to. Machine-local churn; Android Studio's own
# template leaves these tracked, which is wrong for a repo used from more than one machine.
/.idea/deploymentTargetSelector.xml
/.idea/deviceManager.xml

# Database pulls off the device. Real training data rather than project source, and it is
# the user's to keep or discard — see db-backups/RESTORE.md before restoring one.
/db-backups
