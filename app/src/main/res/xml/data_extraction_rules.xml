<?xml version="1.0" encoding="utf-8"?><!--
    API 31 and above. backup_rules.xml is the same rule for older devices; keep them in step.

    Both paths are excluded, not just cloud-backup. Device transfer is the local phone-to-phone
    copy, and it has the same two problems: it moves an account key off the device, and it
    moves a file encrypted with a Keystore key that does not travel with it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="kinex.identity.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="kinex.identity.xml" />
    </device-transfer>
</data-extraction-rules>
